# Adiox Copy Trading — served at https://copytrading.adiox.io (this folder is the subdomain's document root).
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType image/webp .webp

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If this folder is reached as adiox.io/copytrading/…, send visitors to the subdomain (path kept).
  RewriteCond %{HTTP_HOST} ^(www\.)?adiox\.io$ [NC]
  RewriteRule ^(.*)$ https://copytrading.adiox.io/$1 [R=301,L,NE]

  # One canonical origin for the subdomain: https, no www.
  RewriteCond %{HTTP_HOST} ^www\.copytrading\.adiox\.io$ [NC]
  RewriteRule ^ https://copytrading.adiox.io%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^copytrading\.adiox\.io$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://copytrading.adiox.io%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "^llms\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
